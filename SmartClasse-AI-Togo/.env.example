# .env — Configuration Environment Variables
# Copy this file to .env and fill in your values

# API
API_TITLE=EduPath AI
API_VERSION=0.1.0
PORT=8000
DEBUG=False

# LLM
LLM_MODEL=gemma4:e4b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=8192

# Ollama (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# Audio
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
SAMPLE_RATE=16000

# Database
DATABASE_URL=sqlite:///./edupath_ai.db
DATABASE_ENCRYPT=True
ENCRYPTION_KEY=your_secret_key_here_32_chars_min

# Features
ENABLE_CULTURIX=True
ENABLE_RESEARCHIX=True
ENABLE_PASSPORTIX=True
ENABLE_EQUITIX=True
ENABLE_PARENTIX=False

# Paths
MEPS_CURRICULUM_PATH=./data/meps_curriculum.json
CULTURAL_CORPUS_PATH=./data/cultural_corpus.json

# Optional: SMS Gateway (for PARENTIX)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
